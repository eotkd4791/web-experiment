{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "cache": true,
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "cache": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "cache": true,
      "outputs": ["storybook-static/**"]
    }
  }
}
