{
  "name": "@app/api",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "oxlint --config ../../.oxlintrc.json src && eslint src",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix src && eslint --fix src",
    "format": "oxfmt --config ../../.oxfmtrc.json --write src",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.6.1",
    "wrangler": "^4.110.0"
  }
}
