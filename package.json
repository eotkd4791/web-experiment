{
  "name": "web-experiment",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@app/api",
    "dev:next": "turbo dev --filter=@app/next",
    "dev:react": "turbo dev --filter=@package/react",
    "build": "turbo build",
    "lint": "oxlint --config .oxlintrc.json .",
    "lint:fix": "oxlint --config .oxlintrc.json --fix .",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --config .oxfmtrc.json --check .",
    "typecheck": "turbo typecheck",
    "storybook": "turbo storybook --filter=@app/storybook",
    "build-storybook": "turbo build-storybook --filter=@app/storybook",
    "test:api": "turbo test --filter=@app/api",
    "test:next": "turbo test --filter=@app/next",
    "test:react": "turbo test --filter=@package/react",
    "test:shared": "turbo test --filter=@package/shared"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@app/next": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@package/react": "workspace:*",
    "@package/shared": "workspace:*",
    "@tanstack/react-form": "^1.33.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "eslint": "9.39.4",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
